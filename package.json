{
  "name": "feenstra-light-surveys",
  "version": "1.0.0",
  "private": true,
  "description": "Offline lighting surveys and OHS report export",
  "scripts": {
    "build": "node scripts/copy_ocr_assets.cjs && vite build",
    "check": "node --check www/app.js",
    "forms:extract": "node scripts/extract_check_templates.mjs",
    "start": "node server/index.cjs",
    "android:add": "cap add android",
    "android:sync": "cap sync android",
    "postinstall": "node scripts/patch_capacitor_cli.cjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/core": "6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/share": "^6.0.4",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "pdfjs-dist": "^4.10.38",
    "read-excel-file": "^9.3.12",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "vite": "6.4.4"
  },
  "overrides": {
    "tar": "^7.5.21"
  }
}
