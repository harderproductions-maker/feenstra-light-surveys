POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=primeops
POSTGRES_USER=primeops
JWT_SECRET=replace-with-at-least-32-random-characters
# Initial client bootstrap account, not the separate PrimeOps platform login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
APP_PORT=3000
# Private administrator listener. Never publish this port or proxy it on the client hostname.
# Direct Node binds to 127.0.0.1 by default; Compose publishes this only on host loopback.
ADMIN_PORT=3001
# Add the exact public HTTPS origin when behind a TLS reverse proxy or using a separate web app.
CORS_ORIGINS=capacitor://localhost,http://localhost,https://localhost,primeops://app
# Explicit opt-in after backing up and provisioning each client's leasing test schema.
# Comma-separated registered company codes; blank disables the test API for every client.
LEASING_TEST_COMPANIES=
# Folder on this PC where completed checklists are saved (admins pick a sub-folder in the app's Report storage tab).
# Example for Windows: REPORTS_DIR=D:/PrimeOps Reports
REPORTS_DIR=./reports
COMPANY_REPORTS_DIR=./company-reports
# Folder containing manifest.json and the matching signed, versioned APK.
ANDROID_UPDATES_DIR=./android-updates
# Legacy file-generator setup only. The Windows owner app registers keys automatically.
LICENSE_KEYS_DIR=./licence-public
# Docker: set to /data/licence/licence-owner-public.pem after copying the key.
# Direct Node/Windows: set to the absolute public-key file path instead.
# Leave blank until the owner creates their keys; the app stays on its activation screen.
LICENSE_PUBLIC_KEY_FILE=
# Only for docker-compose.selfhost.yml: the token from your Cloudflare Tunnel.
TUNNEL_TOKEN=
# Public client HTTPS origin used by Payfast (never the private administration URL).
PUBLIC_APP_URL=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Set true while testing. Test notifications never settle real client invoices.
PAYFAST_SANDBOX=true
# Optional invoice email. Credentials remain on the server.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
