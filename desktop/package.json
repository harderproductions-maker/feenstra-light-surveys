{
  "name": "primeops-desktop",
  "version": "1.1.0",
  "description": "PrimeOps desktop app",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "node prepare.cjs && electron-builder --win zip --x64"
  },
  "build": {
    "appId": "com.primeops.desktop",
    "productName": "PrimeOps",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "settings.html", "preload.cjs", "preload-app.cjs", "icon.png", "www/**/*"],
    "win": { "signAndEditExecutable": false },
    "artifactName": "PrimeOps-Windows-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
