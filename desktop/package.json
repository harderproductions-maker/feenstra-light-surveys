{
  "name": "feenstra-building-and-ohs-desktop",
  "version": "1.0.0",
  "description": "FG Ops desktop app",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "node prepare.cjs && electron-builder --win zip --x64"
  },
  "build": {
    "appId": "com.feenstra.buildingohs.desktop",
    "productName": "FG Ops",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "settings.html", "preload.cjs", "preload-app.cjs", "icon.png", "www/**/*"],
    "win": { "signAndEditExecutable": false },
    "artifactName": "FG-Ops-Windows-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
