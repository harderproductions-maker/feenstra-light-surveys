{
  "name": "feenstra-building-and-ohs-desktop",
  "version": "1.0.0",
  "description": "Feenstra Building and OHS desktop app",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "node prepare.cjs && electron-builder --win zip --x64"
  },
  "build": {
    "appId": "com.feenstra.buildingohs.desktop",
    "productName": "Feenstra Building and OHS",
    "directories": { "output": "dist" },
    "files": ["main.cjs", "settings.html", "preload.cjs", "www/**/*"],
    "win": { "signAndEditExecutable": false },
    "artifactName": "Feenstra-Building-And-OHS-Windows-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
